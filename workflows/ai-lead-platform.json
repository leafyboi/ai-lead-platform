    {
      "parameters": {
        "jsCode": "for (const item of $input.all()) {\n  const rawUrl = (item.json['Your website or portfolio link (optional)'] || '').trim();\n  \n  if (rawUrl) {\n    let validUrl = rawUrl;\n    if (!/^https?:\\/\\//i.test(validUrl)) {\n      validUrl = 'https://' + validUrl;\n    }\n    item.json.targetUrl = validUrl;\n    item.json.hasLink = true;\n  } else {\n    item.json.targetUrl = 'https://httpbin.org/get';\n    item.json.hasLink = false;\n  }\n\n  // контакты\n  item.json.cleanEmail = (item.json['Your e-mail'] || '').trim().toLowerCase();\n  item.json.clientName = (item.json['Your name'] || 'Client').trim();\n\n  // поля для Airtable\n  item.json.lead_status = 'New';\n  item.json.lead_source = 'Website';\n  item.json.created_at = new Date().toISOString();\n}\n\nreturn $input.all();"
      },
